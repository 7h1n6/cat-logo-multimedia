<%- include('../partials/header') %>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Panel de Categorías y Géneros</h2>
    <a href="/" class="btn btn-secondary">Volver al Inicio</a>
</div>

<!-- Formulario para crear Categoría Base -->
<div class="card mb-4 shadow-sm">
    <div class="card-body">
        <h5 class="card-title">Crear nueva Categoría Principal</h5>
        <form action="/taxonomy/create-category" method="POST" class="d-flex gap-2">
            <input type="text" name="categoriaBase" class="form-control" placeholder="Ej: Música, Novelas, etc." required>
            <button type="submit" class="btn btn-primary text-nowrap">Crear Categoría</button>
        </form>
    </div>
</div>

<!-- Acordeón de Categorías -->
<div class="accordion" id="accordionTaxonomy">
    <% taxonomies.forEach((tax, index) => { %>
        <div class="accordion-item">
            <h2 class="accordion-header" id="heading-<%= tax._id %>">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-<%= tax._id %>">
                    <strong><%= tax.categoriaBase %></strong>
                </button>
            </h2>
            <div id="collapse-<%= tax._id %>" class="accordion-collapse collapse" data-bs-parent="#accordionTaxonomy">
                <div class="accordion-body">
                    
                    <!-- Formulario para añadir Subcategoría a esta Categoría -->
                    <form action="/taxonomy/add-subcategory" method="POST" class="d-flex gap-2 mb-3">
                        <input type="hidden" name="categoryId" value="<%= tax._id %>">
                        <input type="text" name="subcategoriaNombre" class="form-control form-control-sm" placeholder="Nueva subcategoría (Ej: Sega Genesis)" required>
                        <button type="submit" class="btn btn-sm btn-success text-nowrap">Añadir Subcategoría</button>
                    </form>

                    <!-- Lista de Subcategorías -->
                    <ul class="list-group">
                        <% if (tax.subcategorias.length === 0) { %>
                            <li class="list-group-item text-muted">No hay subcategorías aún.</li>
                        <% } %>
                        
                        <% tax.subcategorias.forEach(sub => { %>
                            <li class="list-group-item">
                                <div class="d-flex justify-content-between align-items-center">
                                    <strong><%= sub.nombre %></strong>
                                </div>
                                
                                <!-- Formulario para añadir Géneros a esta Subcategoría -->
                                <form action="/taxonomy/add-genre" method="POST" class="d-flex gap-2 mt-2">
                                    <input type="hidden" name="categoryId" value="<%= tax._id %>">
                                    <input type="hidden" name="subcategoriaId" value="<%= sub._id %>">
                                    <input type="text" name="generoNombre" class="form-control form-control-sm" placeholder="Nuevo género (Ej: RPG)" required>
                                    <button type="submit" class="btn btn-sm btn-outline-primary text-nowrap">Añadir Género</button>
                                </form>
                                
                                <!-- Etiquetas de Géneros -->
                                <div class="mt-2">
                                    <% if (sub.generos.length === 0) { %>
                                        <span class="text-muted small">Sin géneros</span>
                                    <% } %>
                                    <% sub.generos.forEach(gen => { %>
                                        <span class="badge bg-info text-dark me-1"><%= gen %></span>
                                    <% }) %>
                                </div>
                            </li>
                        <% }) %>
                    </ul>

                </div>
            </div>
        </div>
    <% }) %>
</div>

<%- include('../partials/footer') %>