<%- include('partials/header') %>

<div class="text-center mt-5">
    <h1 class="display-4">Catálogo Multimedia</h1>
    <p class="lead">Tu gestor personal de series, juegos, películas y más.</p>
    
    <% if (typeof currentUser !== 'undefined' && currentUser) { %>
        <div class="alert alert-info">
            ¡Bienvenido de nuevo, <strong><%= currentUser.name %></strong>!
        </div>
        <a href="/items" class="btn btn-primary btn-lg mt-3">Ver mis Ítems</a>
        
        <% if (currentUser.role === 'admin') { %>
            <a href="/taxonomy" class="btn btn-warning btn-lg mt-3">Administrar Categorías</a>
        <% } %>
    <% } else { %>
        <p class="mt-4">Por favor, inicia sesión o regístrate para comenzar a crear tu catálogo.</p>
        <a href="/auth/login" class="btn btn-primary btn-lg mt-2">Iniciar Sesión</a>
        <a href="/auth/register" class="btn btn-success btn-lg mt-2">Registrarse</a>
    <% } %>
</div>

<%- include('partials/footer') %>