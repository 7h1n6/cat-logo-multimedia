<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title || 'Catálogo Multimedia' %></title>
    <!-- Usaremos Bootstrap por CDN para que se vea bien rápido -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand" href="/">Catálogo Multimedia</a>
            <div class="navbar-nav ms-auto">
                <% if (typeof currentUser !== 'undefined' && currentUser) { %>
                    <!-- Si hay usuario logueado -->
                    <span class="navbar-text me-3">Hola, <%= currentUser.name %></span>
                    <% if (currentUser.role === 'admin') { %>
                        <a class="nav-link text-warning" href="#">Panel Admin</a>
                    <% } %>
                    <a class="nav-link text-danger" href="/auth/logout">Salir</a>
                <% } else { %>
                    <!-- Si no hay usuario -->
                    <a class="nav-link" href="/auth/login">Login</a>
                    <a class="nav-link" href="/auth/register">Registro</a>
                <% } %>
            </div>
        </div>
    </nav>
    <div class="container mt-4">
        <!-- Mensajes Flash -->
        <% if (typeof success !== 'undefined' && success.length > 0) { %>
            <div class="alert alert-success"><%= success %></div>
        <% } %>
        <% if (typeof error !== 'undefined' && error.length > 0) { %>
            <div class="alert alert-danger"><%= error %></div>
        <% } %>